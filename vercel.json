{
  "outputDirectory": "public",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    },
    {
      "source": "/c/:slug",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?slot=morning",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?slot=night",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  }
}
